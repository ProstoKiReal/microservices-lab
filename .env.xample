# Shared Infrastructire
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_HOST=rabbitmq

# Notification Service
NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_HOST=notification-db
NOTIFICATION_DB_PORT=5432
NOTIFICATION_DB_PASSWORD=12345678
NOTIFICATION_DB_USER=notification_user

NOTIFICATION_APP_PORT=8001
NOTIFICATION_APP_HOST=notification-service
NOTIFICATION_APP_MODE=dev/prod

NOTIFICATION_ALCHEMY_POOL_SIZE=20
NOTIFICATION_ALCHEMY_AUTOFLUSH=true
NOTIFICATION_ALCHEMY_EXPIRE_ON_COMMIT=true